; Godot Engine project configuration.
config_version=5

[application]
config/name="Clay Factory — Endless Cut"
config/version="2.0.2-preview"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/ui/premium/emblem.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(1, 0.965, 0.914, 1)

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[internationalization]
locale/translations=PackedStringArray("res://scripts/localization/strings.en.translation", "res://scripts/localization/strings.uk.translation", "res://scripts/localization/strings.pl.translation", "res://scripts/localization/strings.de.translation", "res://scripts/localization/strings.es.translation", "res://scripts/localization/strings.fr.translation")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.13, 0.071, 0.22, 1)

[clay]
leaderboard_url=""
